# Copy to .env and replace the placeholder values with random secrets.
APP_ENV=development
SECRET_KEY=replace-with-a-random-secret
JWT_SECRET_KEY=replace-with-a-different-random-secret
JWT_COOKIE_SECURE=false

# These limits apply independently by client IP and normalized account identifier.
LOGIN_IP_RATE_LIMIT=5 per 15 minutes
LOGIN_IDENTIFIER_RATE_LIMIT=10 per hour

# Local development only. Production requires a shared Redis backend.
RATELIMIT_STORAGE_URI=memory://
